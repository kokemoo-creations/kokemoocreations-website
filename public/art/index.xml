			<item>
				<title>Patches n&#39; Badges</title>
				<link>https://example.org/art/patches/</link>
				<pubDate>Thu, 15 Oct 2026 00:00:00 +0000</pubDate>
				<guid>https://example.org/art/patches/</guid>
				<description>&lt;style&gt;&#xD;&#xA;   &#xD;&#xA;  &#xD;&#xA;   &#xD;&#xA;  .gslide-description {&#xD;&#xA;    position: absolute !important;&#xD;&#xA;    bottom: 0;&#xD;&#xA;    left: 0;&#xD;&#xA;    width: 100%;&#xD;&#xA;    background: rgba(0, 0, 0, 0.75) !important;  &#xD;&#xA;    margin: 0 !important;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;   &#xD;&#xA;  .gdesc-inner {&#xD;&#xA;    background: transparent !important;&#xD;&#xA;    padding: 1.5rem !important;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;   &#xD;&#xA;  .gslide-title {&#xD;&#xA;    color: #ffffff !important;&#xD;&#xA;    font-family: inherit !important;  &#xD;&#xA;    font-weight: 600;&#xD;&#xA;    margin-bottom: 0.5rem !important;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;   &#xD;&#xA;  .gslide-desc {&#xD;&#xA;    color: #e5e7eb !important;  &#xD;&#xA;    margin: 0 !important;&#xD;&#xA;    &#xD;&#xA;     &#xD;&#xA;    font-family: inherit !important; &#xD;&#xA;    &#xD;&#xA;     &#xD;&#xA;     &#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;   &#xD;&#xA;  .gslide-desc a {&#xD;&#xA;    color: #a7d8ff !important;&#xD;&#xA;    text-decoration: underline;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .contour-gallery {&#xD;&#xA;     &#xD;&#xA;    column-count: 1;&#xD;&#xA;    column-gap: 1rem;&#xD;&#xA;    margin: 2rem 0;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;   &#xD;&#xA;  @media (min-width: 600px) {&#xD;&#xA;    .contour-gallery { column-count: 2; }&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;   &#xD;&#xA;  @media (min-width: 900px) {&#xD;&#xA;    .contour-gallery { column-count: 3; }&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;.contour-gallery .gallery-item {&#xD;&#xA;    break-inside: avoid;&#xD;&#xA;    margin-bottom: 1rem;&#xD;&#xA;    border-radius: 0.5rem;&#xD;&#xA;    overflow: hidden;&#xD;&#xA;    &#xD;&#xA;     &#xD;&#xA;    opacity: 0;&#xD;&#xA;    transform: translateY(40px);&#xD;&#xA;    transition: opacity 0.7s ease-out, transform 0.7s ease-out;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;  .contour-gallery .gallery-item.is-visible {&#xD;&#xA;    opacity: 1;&#xD;&#xA;    transform: translateY(0);&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .contour-gallery .gallery-item a {&#xD;&#xA;    display: block;&#xD;&#xA;    cursor: zoom-in;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .contour-gallery .gallery-item img {&#xD;&#xA;    width: 100%;&#xD;&#xA;    height: auto; &#xD;&#xA;    display: block;&#xD;&#xA;    transition: transform 0.3s ease;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .contour-gallery .gallery-item:hover img {&#xD;&#xA;    transform: scale(1.03);&#xD;&#xA;  }&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xD;&#xA;&lt;div class=&#34;contour-gallery&#34;&gt;&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &lt;div class=&#34;gallery-item&#34;&gt;&#xD;&#xA;      &lt;a href=&#34;https://example.org/art/patches/Disability%20Badge%20Showcase.png&#34; class=&#34;glightbox&#34; data-title=&#34;Disability Badge Showcase.png&#34; data-description=&#34;Disability Badge Showcase.png&#34;&gt;&#xD;&#xA;        &lt;img src=&#34;https://example.org/art/patches/Disability%20Badge%20Showcase.png&#34; alt=&#34;Disability Badge Showcase.png&#34; loading=&#34;lazy&#34; /&gt;&#xD;&#xA;      &lt;/a&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;  &lt;link rel=&#34;stylesheet&#34; href=&#34;https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css&#34; /&gt;&#xD;&#xA;  &#xD;&#xA;  &lt;script src=&#34;https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js&#34; onload=&#34;GLightbox({ selector: &#39;.glightbox&#39;, touchNavigation: true, loop: true })&#34;&gt;&#xD;&#xA;    &#xD;&#xA;  &lt;/script&gt;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;  document.addEventListener(&#34;DOMContentLoaded&#34;, function() {&#xD;&#xA;    const observerOptions = {&#xD;&#xA;      root: null,&#xD;&#xA;      rootMargin: &#34;0px 0px -50px 0px&#34;, &#xD;&#xA;      threshold: 0.1&#xD;&#xA;    };&#xD;&#xA;&#xD;&#xA;    const observer = new IntersectionObserver((entries, observer) =&gt; {&#xD;&#xA;      entries.forEach(entry =&gt; {&#xD;&#xA;        if (entry.isIntersecting) {&#xD;&#xA;          entry.target.classList.add(&#39;is-visible&#39;);&#xD;&#xA;          observer.unobserve(entry.target); &#xD;&#xA;        }&#xD;&#xA;      });&#xD;&#xA;    }, observerOptions);&#xD;&#xA;&#xD;&#xA;    document.querySelectorAll(&#39;.gallery-item&#39;).forEach(item =&gt; {&#xD;&#xA;      observer.observe(item);&#xD;&#xA;    });&#xD;&#xA;  });&#xD;&#xA;&lt;/script&gt;</description>
			</item>
